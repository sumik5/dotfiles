{
  "mcpServers": {
    "context7": {
      "command": "/Users/sumik/.local/share/mise/shims/npx",
      "args": [
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "${CONTEXT7_API_KEY}"
      ],
      "env": {}
    },
    "serena": {
      "command": "/Users/sumik/.local/share/mise/shims/uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant"
      ],
      "env": {}
    },
    "playwright": {
      "command": "/Users/sumik/.local/share/mise/shims/npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "kagi": {
      "command": "/Users/sumik/.local/share/mise/shims/uvx",
      "args": [
        "kagimcp"
      ],
      "env": {
        "KAGI_API_KEY": "${KAGI_API_KEY}",
        "KAGI_SUMMARIZER_ENGINE": "cecil",
        "UV_NATIVE_TLS": "true"
      }
    },
    "deepwiki": {
      "command": "/Users/sumik/.local/share/mise/shims/npx",
      "args": [
        "mcp-remote",
        "https://mcp.deepwiki.com/sse"
      ],
      "env": {}
    },
    "sequentialthinking": {
      "command": "/Users/sumik/.local/share/mise/shims/npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "docset": {
      "command": "/Users/sumik/.local/share/mise/shims/uvx",
      "args": [
        "docsetmcp"
      ],
      "env": {
        "DOCSET_PATH": "~/Library/Application Support/Dash/DocSets",
        "CHEATSHEET_PATH": "~/Library/Application Support/Dash/Cheat Sheets"
      }
    },
    "terraform": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "hashicorp/terraform-mcp-server"
      ]
    }
  },
  "preferences": {
    "menuBarEnabled": false
  }
}
