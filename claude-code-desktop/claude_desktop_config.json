{
  "mcpServers": {
    "context7": {
      "command": "/Users/sumik/.local/share/mise/shims/npx",
      "args": ["-y", "@upstash/context7-mcp", "--api-key", "${CONTEXT7_API_KEY}"],
      "env": {}
    },
    "serena": {
      "command": "/Users/sumik/.local/share/mise/shims/uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant"
      ],
      "env": {}
    },
    "playwright": {
      "command": "/Users/sumik/.local/share/mise/shims/npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "env": {}
    },
    "kagi": {
      "command": "/Users/sumik/.local/share/mise/shims/uvx",
      "args": ["kagimcp"],
      "env": {
        "KAGI_API_KEY": "${KAGI_API_KEY}",
        "KAGI_SUMMARIZER_ENGINE": "cecil",
        "UV_NATIVE_TLS": "false",
        "PYTHONHTTPSVERIFY": "0"
      }
    },
    "deepwiki": {
      "command": "/Users/sumik/.local/share/mise/shims/npx",
      "args": ["mcp-remote", "https://mcp.deepwiki.com/sse"],
      "env": {}
    },
    "sequentialthinking": {
      "command": "/Users/sumik/.local/share/mise/shims/npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "docset": {
      "command": "/Users/sumik/.local/share/mise/shims/uvx",
      "args": ["docsetmcp"],
      "env": {
        "DOCSET_PATH": "~/Library/Application Support/Dash/DocSets",
        "CHEATSHEET_PATH": "~/Library/Application Support/Dash/Cheat Sheets"
      }
    },
    "terraform": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "hashicorp/terraform-mcp-server"]
    },
    "codex": {
      "command": "codex",
      "args": ["mcp"]
    },
    "chrome-devtools": {
      "command": "/Users/sumik/.local/share/mise/shims/npx",
      "args": ["chrome-devtools-mcp@latest", "--isolated"]
    },
    "docker": {
      "command": "/Users/sumik/.local/share/mise/shims/uvx",
      "args": ["docker-mcp"]
    },
    "puppeteer": {
      "command": "/Users/sumik/.local/share/mise/shims/npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"]
    },
    "file-system": {
      "command": "/Users/sumik/.local/share/mise/shims/npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem"]
    },
    "firecrawl-mcp": {
      "command": "/Users/sumik/.local/share/mise/shims/npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}",
        "FIRECRAWL_RETRY_MAX_ATTEMPTS": "5",
        "FIRECRAWL_RETRY_INITIAL_DELAY": "2000",
        "FIRECRAWL_RETRY_MAX_DELAY": "30000",
        "FIRECRAWL_RETRY_BACKOFF_FACTOR": "3",
        "FIRECRAWL_CREDIT_WARNING_THRESHOLD": "2000",
        "FIRECRAWL_CREDIT_CRITICAL_THRESHOLD": "500"
      }
    },
    "mcp-pandoc": {
      "command": "/Users/sumik/.local/share/mise/shims/uvx",
      "args": ["mcp-pandoc"],
      "env": {}
    },
    "youtube": {
      "command": "/Users/sumik/.local/share/mise/shims/npx",
      "args": ["-y", "@anaisbetts/mcp-youtube"]
    },
    "markdownify": {
      "command": "/Users/sumik/.local/share/mise/shims/node",
      "args": ["/Users/sumik/dotfiles/claude-code/tools/markdownify-mcp/dist/index.js"],
      "env": {
        "UV_PATH": "/Users/sumik/.local/share/mise/shims/uv"
      }
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    }
  },
  "preferences": {
    "menuBarEnabled": false
  }
}
