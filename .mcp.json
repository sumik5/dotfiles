{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "${CONTEXT7_API_KEY}"
      ],
      "env": {}
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant"
      ],
      "env": {
        "UV_NATIVE_TLS": "true",
        "SSL_CERT_FILE": "${SSL_CERT_FILE}",
        "REQUESTS_CA_BUNDLE": "${REQUESTS_CA_BUNDLE}",
        "PYTHONHTTPSVERIFY": "${PYTHONHTTPSVERIFY}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "kagi": {
      "command": "uvx",
      "args": [
        "kagimcp"
      ],
      "env": {
        "KAGI_API_KEY": "${KAGI_API_KEY}",
        "KAGI_SUMMARIZER_ENGINE": "cecil",
        "UV_NATIVE_TLS": "true",
        "SSL_CERT_FILE": "${SSL_CERT_FILE}"
      }
    },
    "deepwiki": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://mcp.deepwiki.com/sse"
      ],
      "env": {
        "NODE_EXTRA_CA_CERTS": "${NODE_EXTRA_CA_CERTS}",
        "NODE_TLS_REJECT_UNAUTHORIZED": "1"
      }
    },
    "sequentialthinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "docset": {
      "command": "uvx",
      "args": [
        "docsetmcp"
      ],
      "env": {
        "DOCSET_PATH": "~/Library/Application Support/Dash/DocSets",
        "CHEATSHEET_PATH": "~/Library/Application Support/Dash/Cheat Sheets"
      }
    },
    "terraform": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "hashicorp/terraform-mcp-server"
      ]
    }
  }
}
