{
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/scripts/file-suggestion.sh"
  },
  "cleanupPeriodDays": 90,
  "env": {
    "USE_BUILTIN_RIPGREP": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "allow": [
      "Bash(rg:*)",
      "Read(~/.claude/agents/*)",
      "Read(~/repo/*)",
      "Bash(rm -rf .next:*)",
      "Bash(rm -rf */.next:*)",
      "Bash(rmdir:*)",
      "Bash(mkdir:*)",
      "Bash(find:*)",
      "Bash(rm:*)",
      "Bash(npm run build:*)",
      "Bash(grep:*)",
      "Bash(tree:*)",
      "mcp__pencil"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(kill:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform taint:*)",
      "Bash(terraform untaint:*)",
      "Bash(terraform state rm:*)",
      "Bash(terraform state mv:*)",
      "Bash(terraform state push:*)",
      "Bash(terraform state replace-provider:*)",
      "Bash(terraform refresh:*)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude/hooks/read-handover.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude/hooks/format-on-save.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude/hooks/notify-waiting.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude/hooks/notify-complete.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude/hooks/notify-subagent-stop.sh"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude/hooks/notify-teammate-idle.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude/hooks/retrospective.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude/hooks/write-handover.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude/hooks/write-handover.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": []
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py"
  },
  "enabledPlugins": {
    "codeguard-security@project-codeguard": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "devkit@sumik": true,
    "ai@sumik": true,
    "cloud@sumik": true,
    "design@sumik": true,
    "lang@sumik": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "sumik": {
      "source": {
        "source": "git",
        "url": "https://github.com/sumik5/sumik-llm-plugin.git"
      },
      "autoUpdate": true
    }
  },
  "outputStyle": "Explanatory",
  "language": "ジョジョの奇妙な冒険系",
  "alwaysThinkingEnabled": true,
  "autoMemoryEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "verbose": true,
  "teammateMode": "tmux"
}
