{
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/scripts/file-suggestion.sh"
  },
  "cleanupPeriodDays": 90,
  "env": {
    "USE_BUILTIN_RIPGREP": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "allow": [
      "Bash(rg:*)",
      "Read(~/.claude/agents/*)",
      "Read(~/repo/*)",
      "Bash(rm -rf .next:*)",
      "Bash(rm -rf */.next:*)",
      "Bash(rmdir:*)",
      "Bash(mkdir:*)",
      "Bash(find:*)",
      "Bash(rm:*)",
      "Bash(npm run build:*)",
      "Bash(grep:*)",
      "Bash(tree:*)",
      "mcp__pencil"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(kill:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform taint:*)",
      "Bash(terraform untaint:*)",
      "Bash(terraform state rm:*)",
      "Bash(terraform state mv:*)",
      "Bash(terraform state push:*)",
      "Bash(terraform state replace-provider:*)",
      "Bash(terraform refresh:*)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py"
  },
  "enabledPlugins": {
    "codeguard-security@project-codeguard": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "devkit@sumik": true,
    "ai@sumik": true,
    "cloud@sumik": true,
    "design@sumik": true,
    "lang@sumik": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "sumik": {
      "source": {
        "source": "git",
        "url": "https://github.com/sumik5/sumik-llm-plugin.git"
      },
      "autoUpdate": true
    }
  },
  "outputStyle": "Explanatory",
  "language": "罵倒が激しすぎるツンデレ",
  "alwaysThinkingEnabled": true,
  "autoMemoryEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "verbose": true,
  "teammateMode": "in-process"
}
