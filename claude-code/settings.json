{
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/scripts/file-suggestion.sh"
  },
  "cleanupPeriodDays": 90,
  "skillListingBudgetFraction": 0.05,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "RTK_TELEMETRY_DISABLED": "1",
    "USE_BUILTIN_RIPGREP": "1"
  },
  "permissions": {
    "allow": [
      "Bash(rg:*)",
      "Read(~/.claude/agents/*)",
      "Read(~/repo/*)",
      "Bash(rm -rf .next:*)",
      "Bash(rm -rf */.next:*)",
      "Bash(rmdir:*)",
      "Bash(mkdir:*)",
      "Bash(find:*)",
      "Bash(rm:*)",
      "Bash(npm run build:*)",
      "Bash(grep:*)",
      "Bash(tree:*)",
      "mcp__pencil"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(kill:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform taint:*)",
      "Bash(terraform untaint:*)",
      "Bash(terraform state rm:*)",
      "Bash(terraform state mv:*)",
      "Bash(terraform state push:*)",
      "Bash(terraform state replace-provider:*)",
      "Bash(terraform refresh:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-sonnet-5[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/sumik/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh",
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py"
  },
  "enabledPlugins": {
    "ai@sumik": true,
    "claude-code-setup@claude-plugins-official": true,
    "cloud@sumik": true,
    "codeguard-security@project-codeguard": true,
    "codex@openai-codex": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "design@sumik": true,
    "devkit@sumik": true,
    "document-skills@anthropic-agent-skills": true,
    "exam@sumik": true,
    "example-skills@anthropic-agent-skills": true,
    "github@claude-plugins-official": true,
    "google@sumik": true,
    "gopls-lsp@claude-plugins-official": true,
    "lang@sumik": true,
    "matchapp-kit@local-desktop-app-uploads": true,
    "product@sumik": true,
    "pyright-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "studio@sumik": true,
    "typescript-lsp@claude-plugins-official": true,
    "university@sumik": true,
    "web@sumik": true,
    "mobile@sumik": true,
    "certificate@sumik": true,
    "genshijin@genshijin": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "sumik": {
      "source": {
        "source": "git",
        "url": "https://github.com/sumik5/sumik-llm-plugin.git"
      },
      "autoUpdate": false
    },
    "tips-marketplace": {
      "source": {
        "source": "directory",
        "path": "/Users/sumik/Dropbox/tips"
      }
    },
    "genshijin": {
      "source": {
        "source": "github",
        "repo": "InterfaceX-co-jp/genshijin"
      }
    }
  },
  "outputStyle": "Explanatory",
  "language": "罵倒が激しすぎるツンデレ",
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "editorMode": "normal",
  "verbose": true,
  "teammateMode": "in-process",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
