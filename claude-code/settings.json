{
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/scripts/file-suggestion.sh"
  },
  "cleanupPeriodDays": 90,
  "env": {
    "USE_BUILTIN_RIPGREP": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(rg:*)",
      "Read(~/.claude/agents/*)",
      "Read(~/repo/*)",
      "Bash(rm -rf .next:*)",
      "Bash(rm -rf */.next:*)",
      "Bash(rmdir:*)",
      "Bash(mkdir:*)",
      "Bash(find:*)",
      "Bash(rm:*)",
      "Bash(npm run build:*)",
      "Bash(grep:*)",
      "Bash(tree:*)",
      "mcp__pencil"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(kill:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform taint:*)",
      "Bash(terraform untaint:*)",
      "Bash(terraform state rm:*)",
      "Bash(terraform state mv:*)",
      "Bash(terraform state push:*)",
      "Bash(terraform state replace-provider:*)",
      "Bash(terraform refresh:*)"
    ],
    "defaultMode": "default"
  },
  "model": "opus",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude/hooks/format-on-save.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude/hooks/notify-waiting.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude/hooks/notify-complete.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx ccstatusline@latest"
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": false,
    "code-review@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "mcp-toolkit@docker": true,
    "codeguard-security@project-codeguard": true,
    "context7-skill@context7-skill": false,
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "sumik@sumik": true,
    "ralph-loop@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "artifacts-builder@awesome-claude-skills": true,
    "changelog-generator@awesome-claude-skills": true,
    "content-research-writer@awesome-claude-skills": true,
    "document-skills-docx@awesome-claude-skills": true,
    "document-skills-pdf@awesome-claude-skills": true,
    "document-skills-pptx@awesome-claude-skills": true,
    "document-skills-xlsx@awesome-claude-skills": true,
    "domain-name-brainstormer@awesome-claude-skills": true,
    "file-organizer@awesome-claude-skills": true,
    "image-enhancer@awesome-claude-skills": true,
    "internal-comms@awesome-claude-skills": true,
    "lead-research-assistant@awesome-claude-skills": true,
    "meeting-insights-analyzer@awesome-claude-skills": true,
    "skill-creator@awesome-claude-skills": true,
    "slack-gif-creator@awesome-claude-skills": true,
    "tailored-resume-generator@awesome-claude-skills": true,
    "template-skill@awesome-claude-skills": true,
    "theme-factory@awesome-claude-skills": true,
    "video-downloader@awesome-claude-skills": true,
    "webapp-testing@awesome-claude-skills": true
  },
  "outputStyle": "Explanatory",
  "language": "ジョジョの奇妙な冒険系",
  "alwaysThinkingEnabled": true
}
