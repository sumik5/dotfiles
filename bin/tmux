#!/bin/bash
# tmux shim for WezTerm - translates tmux CLI to wezterm cli
# Enables Claude Code Agent Team to work with WezTerm's built-in multiplexer

set -euo pipefail

REAL_TMUX=/opt/homebrew/bin/tmux

# new-window の並列呼び出しを直列化するためのロックディレクトリ。
# Agent Team が複数ペインを同時起動すると「レイアウト読取→判断→分割」が競合し、
# 本体ペインが繰り返し横分割されて階段状に崩壊する。これを mkdir のアトミック性で防ぐ。
NEWWIN_LOCK_DIR="${TMPDIR:-/tmp}/wezterm-tmux-shim-newwin.lock"
_newwin_lock_held=false

# If not in WezTerm, pass through to real tmux
if [[ -z "${WEZTERM_PANE:-}" ]]; then
  exec "$REAL_TMUX" "$@"
fi

# --- Utility functions ---

# new-window 用の排他ロックを取得（mkdir はアトミックなので成功した者だけが保持）
acquire_newwin_lock() {
  local waited=0
  while ! mkdir "$NEWWIN_LOCK_DIR" 2>/dev/null; do
    sleep 0.05
    waited=$((waited + 1))
    # 5秒(=100回)経っても取れない場合は stale lock とみなし強制解放してリトライ
    if [[ $waited -ge 100 ]]; then
      rmdir "$NEWWIN_LOCK_DIR" 2>/dev/null || true
      waited=0
    fi
  done
  _newwin_lock_held=true
}

# new-window 用の排他ロックを解放（_newwin_lock_held フラグで二重解放を防止）
release_newwin_lock() {
  if [[ "$_newwin_lock_held" == true ]]; then
    rmdir "$NEWWIN_LOCK_DIR" 2>/dev/null || true
    _newwin_lock_held=false
  fi
}

# Strip % prefix from tmux pane ID to get WezTerm pane ID
strip_pane_prefix() {
  echo "${1#%}"
}

# Add % prefix to WezTerm pane ID to make tmux pane ID
add_pane_prefix() {
  echo "%${1}"
}

# Extract pane ID from a tmux target string (session:window.pane or %N)
parse_target_pane() {
  local target="$1"
  # If it starts with %, it's a direct pane ID
  if [[ "$target" == %* ]]; then
    strip_pane_prefix "$target"
    return
  fi
  # If it contains a dot, extract the pane part after the last dot
  if [[ "$target" == *.* ]]; then
    local pane_part="${target##*.}"
    strip_pane_prefix "$pane_part"
    return
  fi
  # Otherwise treat as-is (might be a window/session reference)
  echo "$target"
}

# Get pane info from wezterm cli list as JSON
get_pane_list_json() {
  wezterm cli list --format json 2>/dev/null
}

# Look up tab_id for a given pane_id
get_tab_id_for_pane() {
  local pane_id="$1"
  get_pane_list_json | python3 -c "
import sys, json
panes = json.load(sys.stdin)
for p in panes:
    if str(p['pane_id']) == '$pane_id':
        print(p['tab_id'])
        sys.exit(0)
sys.exit(1)
" 2>/dev/null
}

# Look up window_id for a given pane_id
get_window_id_for_pane() {
  local pane_id="$1"
  get_pane_list_json | python3 -c "
import sys, json
panes = json.load(sys.stdin)
for p in panes:
    if str(p['pane_id']) == '$pane_id':
        print(p['window_id'])
        sys.exit(0)
sys.exit(1)
" 2>/dev/null
}

# Resolve a window target to a tab_id
resolve_window_target() {
  local target="$1"
  # shim 自身が display-message / list-windows で出力する window ID 形式 "@N" を受け取った場合、
  # @ を剥がして数値 tab_id を返す（例: @8 → 8）
  if [[ "$target" == @* ]]; then
    echo "${target#@}"
    return
  fi
  # tmux の session:window 形式はそのまま解決できないため、現在 pane の tab を返す
  if [[ "$target" == *:* ]]; then
    get_tab_id_for_pane "$WEZTERM_PANE"
    return
  fi
  # それ以外はそのまま返す（数値 tab_id が直接渡された場合など）
  echo "$target"
}

# --- Command handlers ---

handle_split_window() {
  local target_pane="$WEZTERM_PANE"
  local direction="--bottom"  # default: vertical split in tmux = bottom in wezterm
  local size_args=()
  local print_pane=false
  local prog=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -t)
        target_pane="$(parse_target_pane "$2")"
        shift 2
        ;;
      -h)
        direction="--right"  # horizontal split in tmux = right in wezterm
        shift
        ;;
      -v)
        direction="--bottom"  # vertical split in tmux = bottom in wezterm
        shift
        ;;
      -l)
        local size="$2"
        if [[ "$size" == *% ]]; then
          size_args=(--percent "${size%\%}")
        else
          size_args=(--cells "$size")
        fi
        shift 2
        ;;
      -P)
        print_pane=true
        shift
        ;;
      -F)
        # Ignore format string, we always output %N
        shift 2
        ;;
      -d)
        # tmux -d means don't switch to new pane; WezTerm split doesn't switch by default
        shift
        ;;
      --)
        shift
        prog=("$@")
        break
        ;;
      *)
        prog+=("$1")
        shift
        ;;
    esac
  done

  local cmd=(wezterm cli split-pane "$direction" --pane-id "$target_pane")
  if [[ ${#size_args[@]} -gt 0 ]]; then
    cmd+=("${size_args[@]}")
  fi
  # Claude Code の teammate 起動は `split-window ... -- cat` でプレースホルダ pane を作り、直後に
  # `respawn-pane -t <id> -- <実コマンド>` で中身を差し替える。WezTerm には respawn 等価の CLI が無く、
  # pane id を維持する必要があるため、プレースホルダの cat はそのまま起動せずデフォルト shell で pane を
  # 保持し、respawn-pane 側で send-text により実コマンドを注入する（handle_respawn_pane を参照）。
  if [[ ${#prog[@]} -eq 1 && "${prog[0]}" == "cat" ]]; then
    prog=()
  fi
  if [[ ${#prog[@]} -gt 0 ]]; then
    cmd+=(-- "${prog[@]}")
  fi

  local new_pane_id
  new_pane_id=$("${cmd[@]}" 2>/dev/null)

  if [[ "$print_pane" == true ]]; then
    add_pane_prefix "$new_pane_id"
  fi
}

handle_new_window() {
  local target=""
  local name=""
  local print_pane=false
  local prog=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -t)
        target="$2"
        shift 2
        ;;
      -n)
        name="$2"
        shift 2
        ;;
      -P)
        print_pane=true
        shift
        ;;
      -F)
        shift 2
        ;;
      -d)
        shift
        ;;
      --)
        shift
        prog=("$@")
        break
        ;;
      *)
        prog+=("$1")
        shift
        ;;
    esac
  done

  # tmux の new-window/new-session は WezTerm では「新しいタブ」になってしまうため、
  # spawn ではなく split-pane を使い現在のタブ内に pane を作る。
  # レイアウト方針（右1列に縦積み）:
  #   - 右に列が無ければ、本体を --right で分割して最初の列を作る
  #   - 既に右に列があれば、その列の最下部に --bottom で縦積みしていく
  # ※ WezTerm は二分木構造のため「列が埋まったらフルハイトの次列へ」は --top-level でも
  #   安定しない（既存ツリーが複雑だと新 pane が意図せぬ位置に挿入され重なる）。
  #   右1列への縦積みに限定することで、レースを直列化すれば確実に動作する。

  # レイアウト読取〜split実行を排他化し、並列起動時の階段化（レース）を防ぐ
  acquire_newwin_lock
  trap release_newwin_lock RETURN EXIT

  local decision
  decision=$(get_pane_list_json | CUR_ID="$WEZTERM_PANE" python3 -c "
import sys, json, os
from collections import defaultdict
panes = json.load(sys.stdin)
cur_id = os.environ['CUR_ID']
cur = next((p for p in panes if str(p['pane_id']) == cur_id), None)
if cur is None:
    sys.exit(1)
tab = cur['tab_id']
base_left = cur['left_col']
# 本体より右にある（同じタブの）pane
right_panes = [p for p in panes if p['tab_id'] == tab and p['left_col'] > base_left]
if not right_panes:
    # 右にまだ列が無い → 本体を右分割して最初の列を作る
    print('RIGHT')
    sys.exit(0)
# 右側の最右列の最下部の下へ縦積み（万一複数列が出来ても最右列に積む）
cols = defaultdict(list)
for p in right_panes:
    cols[p['left_col']].append(p)
rightmost = cols[max(cols.keys())]
bottom = max(rightmost, key=lambda p: p['top_row'])
print('BOTTOM %s' % bottom['pane_id'])
" 2>/dev/null)

  local cmd
  if [[ "$decision" == BOTTOM\ * ]]; then
    cmd=(wezterm cli split-pane --bottom --pane-id "${decision##* }")
  else
    # RIGHT もしくは判定不能時のフォールバック（本体を右分割して列を新設）
    cmd=(wezterm cli split-pane --right --pane-id "$WEZTERM_PANE")
  fi

  if [[ ${#prog[@]} -gt 0 ]]; then
    cmd+=(-- "${prog[@]}")
  fi

  local new_pane_id
  new_pane_id=$("${cmd[@]}" 2>/dev/null)

  release_newwin_lock
  trap - RETURN EXIT

  if [[ "$print_pane" == true ]]; then
    add_pane_prefix "$new_pane_id"
  fi
}

handle_list_panes() {
  local target=""
  local format=""
  local all_flag=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -t)
        target="$2"
        shift 2
        ;;
      -F)
        format="$2"
        shift 2
        ;;
      -a)
        all_flag=true
        shift
        ;;
      *)
        shift
        ;;
    esac
  done

  local tab_id=""
  if [[ -n "$target" ]]; then
    tab_id="$(resolve_window_target "$target")"
  else
    tab_id="$(get_tab_id_for_pane "$WEZTERM_PANE")"
  fi

  # -t が指定されたにもかかわらず tab_id が非数値の場合、
  # 全タブ汚染（tab_id=-1 フォールバック）を防ぐため現 pane の tab に補正する。
  # 修正1（@N → N 変換）により通常は数値が入るが、防御的に二重チェックする。
  if [[ -n "$target" && ( -z "$tab_id" || ! "$tab_id" =~ ^[0-9]+$ ) ]]; then
    tab_id="$(get_tab_id_for_pane "$WEZTERM_PANE")"
  fi

  if [[ "$all_flag" == true ]]; then
    # List all panes across all tabs（-a 明示指定時のみ全列挙）
    get_pane_list_json | python3 -c "
import sys, json
panes = json.load(sys.stdin)
for p in panes:
    print(f'%{p[\"pane_id\"]}')
"
  else
    get_pane_list_json | python3 -c "
import sys, json
tab_id = int('$tab_id') if '$tab_id'.isdigit() else -1
panes = json.load(sys.stdin)
for p in panes:
    if tab_id == -1 or p['tab_id'] == tab_id:
        print(f'%{p[\"pane_id\"]}')
"
  fi
}

handle_send_keys() {
  local target_pane="$WEZTERM_PANE"
  local keys=()
  local literal=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -t)
        target_pane="$(parse_target_pane "$2")"
        shift 2
        ;;
      -l)
        literal=true
        shift
        ;;
      --)
        # tmux のオプション終端区切り。これ以降は全て送信するキー文字列。
        # Claude Code は `send-keys -t <pane> -l -- "<command>"` 形式で teammate 起動
        # コマンドを流し込む。実 tmux と同様、-- 自体は送信内容に含めず消費する
        # （消費し損ねると先頭に "-- " が残り、ペインで "command not found: --" になる）。
        shift
        keys+=("$@")
        break
        ;;
      *)
        keys+=("$1")
        shift
        ;;
    esac
  done

  # Build the text to send
  local text=""
  local append_newline=false

  for i in "${!keys[@]}"; do
    local key="${keys[$i]}"
    # Check if this is the last key and it's Enter/C-m
    if [[ $i -eq $((${#keys[@]} - 1)) ]]; then
      if [[ "$key" == "Enter" || "$key" == "C-m" ]]; then
        append_newline=true
        continue
      fi
    fi
    if [[ -n "$text" ]]; then
      text+=" "
    fi
    text+="$key"
  done

  if [[ "$append_newline" == true ]]; then
    text+=$'\n'
  fi

  if [[ -n "$text" ]]; then
    wezterm cli send-text --pane-id "$target_pane" --no-paste -- "$text"
  fi
}

handle_display_message() {
  local target_pane="$WEZTERM_PANE"
  local format=""
  local print_mode=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -p)
        print_mode=true
        shift
        ;;
      -t)
        target_pane="$(parse_target_pane "$2")"
        shift 2
        ;;
      -F)
        format="$2"
        shift 2
        ;;
      *)
        # Positional argument might be format string
        if [[ -z "$format" ]]; then
          format="$1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$format" ]]; then
    return
  fi

  # Resolve format variables
  local result="$format"

  if [[ "$result" == *'#{pane_id}'* ]]; then
    result="${result//'#{pane_id}'/%${target_pane}}"
  fi

  if [[ "$result" == *'#{window_id}'* ]]; then
    local tab_id
    tab_id="$(get_tab_id_for_pane "$target_pane")"
    result="${result//'#{window_id}'/@${tab_id}}"
  fi

  if [[ "$result" == *'#{session_name}'* ]]; then
    local workspace
    workspace=$(get_pane_list_json | python3 -c "
import sys, json
panes = json.load(sys.stdin)
for p in panes:
    if str(p['pane_id']) == '$target_pane':
        print(p.get('workspace', 'default'))
        sys.exit(0)
print('default')
" 2>/dev/null)
    result="${result//'#{session_name}'/${workspace}}"
  fi

  if [[ "$result" == *'#{pane_current_path}'* ]]; then
    local cwd
    cwd=$(get_pane_list_json | python3 -c "
import sys, json
panes = json.load(sys.stdin)
for p in panes:
    if str(p['pane_id']) == '$target_pane':
        print(p.get('cwd', ''))
        sys.exit(0)
" 2>/dev/null)
    result="${result//'#{pane_current_path}'/${cwd}}"
  fi

  if [[ "$result" == *'#{window_index}'* ]]; then
    local tab_id
    tab_id="$(get_tab_id_for_pane "$target_pane")"
    result="${result//'#{window_index}'/${tab_id}}"
  fi

  echo "$result"
}

handle_capture_pane() {
  local target_pane="$WEZTERM_PANE"
  local print_mode=false
  local start_line=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -t)
        target_pane="$(parse_target_pane "$2")"
        shift 2
        ;;
      -p)
        print_mode=true
        shift
        ;;
      -S)
        start_line="$2"
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done

  local cmd=(wezterm cli get-text --pane-id "$target_pane")
  if [[ -n "$start_line" ]]; then
    cmd+=(--start-line "$start_line")
  fi

  if [[ "$print_mode" == true ]]; then
    "${cmd[@]}" 2>/dev/null
  fi
}

handle_kill_pane() {
  local target_pane="$WEZTERM_PANE"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -t)
        target_pane="$(parse_target_pane "$2")"
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done

  wezterm cli kill-pane --pane-id "$target_pane" 2>/dev/null || true
}

# Claude Code teammate 起動の最終段階。split-window で確保したプレースホルダ pane（デフォルト shell）に、
# 実際の起動コマンド行を send-text で流し込んで teammate プロセスを起動する。WezTerm には pane のプログラムを
# 置換する CLI が無いため、pane id を維持したまま shell にコマンド行＋改行を送り前景実行させる方式を採る。
handle_respawn_pane() {
  local target_pane="$WEZTERM_PANE"
  local prog=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -t)
        target_pane="$(parse_target_pane "$2")"
        shift 2
        ;;
      -k)
        # 既存プログラムの kill 指定。プレースホルダ shell は待機中なので send-text で上書きすれば足りる。
        shift
        ;;
      --)
        shift
        prog=("$@")
        break
        ;;
      *)
        shift
        ;;
    esac
  done

  if [[ ${#prog[@]} -gt 0 ]]; then
    # split-pane で起動した shell が対話可能になるまで僅かに待ってからコマンド行を送る
    # （早すぎると rc 読み込み中に入力が取りこぼされる）。
    sleep 0.3
    local cmdline="${prog[*]}"
    wezterm cli send-text --pane-id "$target_pane" --no-paste -- "${cmdline}"$'\n' 2>/dev/null || true
  fi
}

handle_kill_session() {
  local target=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -t)
        target="$2"
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done

  # Kill all panes in the workspace/tab
  # Since WezTerm doesn't have sessions, we kill all panes in the same tab
  local tab_id
  if [[ -n "$target" ]]; then
    tab_id="$(resolve_window_target "$target")"
  else
    tab_id="$(get_tab_id_for_pane "$WEZTERM_PANE")"
  fi

  get_pane_list_json | python3 -c "
import sys, json
tab_id = int('$tab_id') if '$tab_id'.isdigit() else -1
panes = json.load(sys.stdin)
for p in panes:
    if p['tab_id'] == tab_id:
        print(p['pane_id'])
" 2>/dev/null | while read -r pane_id; do
    wezterm cli kill-pane --pane-id "$pane_id" 2>/dev/null || true
  done
}

handle_select_pane() {
  local target_pane="$WEZTERM_PANE"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -t)
        target_pane="$(parse_target_pane "$2")"
        shift 2
        ;;
      -T)
        # Set pane title - WezTerm doesn't support per-pane titles in the same way
        shift 2
        ;;
      -P)
        # Set pane style (e.g., fg=...,bg=...)
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done

  wezterm cli activate-pane --pane-id "$target_pane" 2>/dev/null || true
}

# --- Main dispatch ---

# Handle flags before subcommand
while [[ $# -gt 0 ]]; do
  case "$1" in
    -V)
      echo "tmux 3.5a"
      exit 0
      ;;
    -L|-S|-f)
      # Skip socket/config options
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

cmd="${1:-}"
shift 2>/dev/null || true

case "$cmd" in
  has-session)
    exit 0
    ;;
  split-window)
    handle_split_window "$@"
    ;;
  new-window)
    handle_new_window "$@"
    ;;
  new-session)
    # Treat new-session as spawn (new tab)
    handle_new_window "$@"
    ;;
  list-panes)
    handle_list_panes "$@"
    ;;
  send-keys)
    handle_send_keys "$@"
    ;;
  select-layout)
    # No-op: WezTerm doesn't have layout algorithms like tmux
    exit 0
    ;;
  respawn-pane)
    handle_respawn_pane "$@"
    ;;
  set-option|set|set-window-option|setw|set-hook|set-environment|rename-window|rename-session|pipe-pane|wait-for)
    # No-op: these commands have no meaningful WezTerm equivalent
    exit 0
    ;;
  list-windows)
    # WezTerm のタブを tmux ウィンドウとして列挙（-a/-F/-t フラグは無視）
    get_pane_list_json | python3 -c "
import sys, json
panes = json.load(sys.stdin)
seen = set()
for p in panes:
    tid = p['tab_id']
    if tid not in seen:
        seen.add(tid)
        print(f'@{tid}')
"
    ;;
  select-pane)
    handle_select_pane "$@"
    ;;
  display-message)
    handle_display_message "$@"
    ;;
  capture-pane)
    handle_capture_pane "$@"
    ;;
  kill-pane)
    handle_kill_pane "$@"
    ;;
  kill-session)
    handle_kill_session "$@"
    ;;
  kill-server)
    exit 0
    ;;
  show-options)
    # Return empty / no-op
    exit 0
    ;;
  switch-client)
    # No-op: WezTerm handles focus differently
    exit 0
    ;;
  resize-pane)
    # Could implement with wezterm cli adjust-pane-size but skip for now
    exit 0
    ;;
  "")
    echo "tmux 3.5a"
    exit 0
    ;;
  *)
    echo "tmux-shim: ignoring unsupported command: $cmd" >&2
    exit 0
    ;;
esac
