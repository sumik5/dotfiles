#!/usr/bin/env bash
#
# git-logs.sh - 署名(GPG/SSH)の検証状態を見やすく表示する git log ラッパー
#
# 概要:
#   git log の出力に「グラフ」「日付」「署名検証ステータス」を付け、
#   1文字のステータス記号(G/B/U/N/E)を絵文字ラベルに置き換えて表示する。
#   デフォルトでは fzf による対話モードで起動し、コミットを選ぶと
#   右側に詳細(git show)が表示される。
#   fzf が無い、または端末(TTY)でない場合は、自動でページャ(less)による
#   スクロール表示(↑↓ や j/k で移動)にフォールバックする。
#
# 使い方:
#   ./git-logs.sh              # 対話モードで表示(fzf があれば)
#   ./git-logs.sh -s           # スクロール表示にする
#   ./git-logs.sh -10          # 最新10件を表示
#   ./git-logs.sh main         # 特定ブランチを表示
#   ./git-logs.sh -s -20       # 最新20件をスクロール表示
#   ./git-logs.sh -h           # ヘルプを表示
#
#   ※ -10 などの git log 用オプションや、ブランチ名はそのまま git log に渡される。
#
# 署名ステータスの意味(git の %G? が返す1文字):
#   G = 有効な署名 (Good)
#   B = 不正な署名 (Bad)
#   U = 有効だが信頼性が不明 (Unknown validity)
#   N = 署名なし (No signature)
#   E = 検証できなかった/鍵が見つからない (Error)
#

# set -euo pipefail: スクリプトを安全に動かすための定番設定
#   -e          : コマンドが失敗(非0終了)したら即座にスクリプトを止める
#   -u          : 未定義の変数を使ったらエラーにする(タイポ検出)
#   -o pipefail : パイプ(|)の途中のコマンドが失敗しても検知できるようにする
set -euo pipefail

# --- ヘルプ表示 -----------------------------------------------------------
# スクリプト自身のファイル名を取得しておく(使用例の表示で使う)。
# basename はパスからファイル名部分だけを取り出す。
SCRIPT_NAME="$(basename "$0")"

# usage: -h / --help で呼ばれたときに使い方を表示する関数。
# ヒアドキュメント(cat <<EOF ... EOF)で複数行をまとめて出力する。
usage() {
  cat <<EOF
${SCRIPT_NAME} - 署名(GPG/SSH)の検証状態を見やすく表示する git log ラッパー

使い方:
  ${SCRIPT_NAME} [オプション] [git log に渡す引数...]

オプション:
  -i, --interactive   対話モードで起動する(fzf が必要)。デフォルトで有効。
                      コミットを選ぶと右側に詳細(git show)を表示する。
  -s, --scroll        対話モードを使わず、スクロール表示(less)にする。
  -h, --help          このヘルプを表示して終了する。

動作の既定:
  デフォルトは対話モード。ただし fzf が無い、または端末(TTY)でない
  (パイプやファイルへのリダイレクト)場合は、自動でスクロール表示に切り替わる。

git log への引数:
  -i / -s / -h などのオプション以外の引数は、そのまま git log に渡される。
  例: -10(最新10件)、ブランチ名、--author=名前、-- パス など。

使用例:
  ${SCRIPT_NAME}              対話モードで表示する(fzf があれば)
  ${SCRIPT_NAME} -s           スクロール表示にする
  ${SCRIPT_NAME} -10          最新10件を表示する
  ${SCRIPT_NAME} main         ブランチ main を表示する
  ${SCRIPT_NAME} -s -20       最新20件をスクロール表示する

スクロール操作(less):
  ↑ / ↓ または j / k   1行ずつ移動
  スペース             1画面送り
  q                    終了

対話モード(fzf)のキー操作:
  ↑ / ↓                コミット一覧を移動
  Ctrl-J / Ctrl-K      コミット一覧を上下に移動
  Ctrl-F / Ctrl-B      プレビュー(右側)を半画面スクロール
  Ctrl-/               プレビューの表示/非表示を切り替え
  Enter                選択して終了
  Esc                  キャンセルして終了

署名ステータスの意味(git の %G? が返す1文字に対応):
  ✅署名OK        有効な署名 (G: Good)
  ❌不正          不正な署名 (B: Bad)
  ⚠️信頼性不明    有効だが信頼性が不明 (U: Unknown validity)
  ⬜署名なし      署名なし (N: No signature)
  ❓検証不可      検証できなかった/鍵が見つからない (E: Error)
EOF
}

# --- 引数の解析 -----------------------------------------------------------
# INTERACTIVE: 対話モード(fzf)を使うかどうかのフラグ。デフォルトは有効(1)。
#   ただし fzf が無い・端末(TTY)でない場合は、後段で自動的に
#   スクロール表示へフォールバックする。
# FORCE_SCROLL: -s / --scroll が指定されたら 1。対話モードを使わず
#   明示的にスクロール表示にする(対話モードを無効化する)。
# GIT_ARGS   : git log にそのまま渡す残りの引数を貯める配列。
INTERACTIVE=1
FORCE_SCROLL=0
GIT_ARGS=()

# 受け取った引数を1つずつ確認する。
for arg in "$@"; do
  case "$arg" in
    -h|--help)
      # -h / --help が来たらヘルプを表示して正常終了する。
      # この時点で他の引数は無視してよい。
      usage
      exit 0
      ;;
    -i|--interactive)
      # -i / --interactive が来たら対話モードを明示的に有効にする。
      # (デフォルトでも有効なので主に -s を打ち消したいとき用)
      # このフラグ自体は git log には渡さない(GIT_ARGS に入れない)。
      INTERACTIVE=1
      FORCE_SCROLL=0
      ;;
    -s|--scroll)
      # -s / --scroll が来たら、対話モードを使わずスクロール表示にする。
      FORCE_SCROLL=1
      ;;
    *)
      # それ以外(-10 や main など)は git log 用の引数として保存する。
      GIT_ARGS+=("$arg")
      ;;
  esac
done

# --- git リポジトリ内かどうかの確認 --------------------------------------
# カレントディレクトリが git 管理下でないなら、わかりやすく終了する。
# rev-parse の出力は不要なので捨てる(>/dev/null 2>&1)。
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "エラー: ここは git リポジトリではありません。" >&2
  exit 1
fi

# --- 表示フォーマットの定義 ----------------------------------------------
# git log の --pretty に渡すフォーマット文字列。
#   %C(auto)        : 以降の色付けを git に自動でやらせる(ハッシュやref名に色)
#   %h              : 短縮コミットハッシュ
#   %d              : ref名(ブランチ/タグ)。例: (HEAD -> main)
#   %C(dim)%cd      : コミット日時を薄い色で表示(後で --date で書式指定)
#   %C(reset)       : 色設定をリセット
#   %x09            : タブ文字。後段の sed が確実に区切りを見つけるための目印
#   %G?             : 署名検証ステータス(G/B/U/N/E のいずれか1文字)
#   %x09 ... %x09   : ステータスをタブで挟むことで「\tG\t」のように一意に置換できる
#   %GS             : 署名者の名前(署名がなければ空)
#   %s              : コミットのタイトル(subject)
FORMAT="%C(auto)%h%d %C(dim)%cd%C(reset)%x09%G?%x09%GS%x09%s"

# --- ステータス文字を絵文字ラベルに変換する関数 -------------------------
# 標準入力で受け取ったログを sed で置換して標準出力に流す。
# タブで挟まれた1文字(\tG\t など)を、見やすい絵文字つきの文字列に置き換える。
decorate() {
  # まず「\t(ステータス)\t(署名者名)\t(subject)」のうち、
  # ステータス部分を絵文字ラベルへ置換する。
  # 続けて、残った区切りタブ(署名者名とsubjectの間など)を半角スペースに
  # 変換して、列のガタつきをなくす。
  sed \
    -e 's/\tG\t/ ✅署名OK /' \
    -e 's/\tB\t/ ❌不正 /' \
    -e 's/\tU\t/ ⚠️信頼性不明 /' \
    -e 's/\tN\t/ ⬜署名なし /' \
    -e 's/\tE\t/ ❓検証不可 /' \
    -e 's/\t/ /g'
}

# --- git log を実行する共通関数 ------------------------------------------
# 引数を git log に渡し、整形済みのログを標準出力に返す。
# --color=always : パイプ経由だと色が消えるので、強制的に色を付ける。
# --date=format  : %cd の日付書式を「年-月-日」に指定。
# "${GIT_ARGS[@]}": 利用者が渡した -10 や main などをそのまま展開して渡す。
#   ${GIT_ARGS[@]+"${GIT_ARGS[@]}"} という書き方は、配列が空のときは
#   何も展開せず、要素があるときだけ展開する定番イディオム。
#   これにより、古い Bash 3.2(macOS 標準)の set -u 下でも、
#   空配列で「unbound variable」エラーにならない。
run_git_log() {
  git log \
    --graph \
    --color=always \
    --date=format:'%Y-%m-%d' \
    --pretty="format:${FORMAT}" \
    ${GIT_ARGS[@]+"${GIT_ARGS[@]}"}
}

# --- メイン処理 -----------------------------------------------------------
# 対話モードを実際に使うかどうかを最終判定する。
# 次のいずれかに当てはまる場合はスクロール表示にフォールバックする:
#   - -s / --scroll が指定された(FORCE_SCROLL=1)
#   - fzf が見つからない
#   - 標準出力が端末(TTY)でない(パイプやファイルへのリダイレクト時)
#     ※ fzf は対話的な端末が必要なため、TTY でないと正しく動かない。
#       [ -t 1 ] は「ファイルディスクリプタ1(標準出力)が端末か」を判定する。
USE_INTERACTIVE=0
if [ "$INTERACTIVE" -eq 1 ] && [ "$FORCE_SCROLL" -eq 0 ]; then
  if command -v fzf >/dev/null 2>&1 && [ -t 1 ]; then
    USE_INTERACTIVE=1
  fi
fi

if [ "$USE_INTERACTIVE" -eq 1 ]; then
  # === 対話モード(fzf 利用。デフォルト) ===
  #
  # fzf の --preview に処理を直接書くと、利用者のシェル(zsh)が
  # sed の正規表現に含まれる角括弧 [0-9;] をグロブと誤解釈して
  #   zsh:[:1: ']' expected
  # のエラーを起こす。これを避けるため、プレビュー処理を独立した
  # シェルスクリプト(#!/bin/sh)に書き出し、fzf からはそれを呼ぶだけにする。
  #
  # ヘルパーは mktemp で確実に存在するパスに作る($0 やインストール先に
  # 依存しない)。fzf の実行中に消えないよう trap での自動削除はせず、
  # fzf が終わった後に明示的に削除する。

  # mktemp で一時ヘルパーを作成する(必ず実在するパスが返る)。
  PREVIEW_HELPER="$(mktemp "${TMPDIR:-/tmp}/glogs-preview.XXXXXX")"

  # ヘルパーの中身を書き出す。
  #   $1 に fzf が選択行を渡す。
  #   1) sed で ANSI 色コードを除去
  #   2) grep でコミットハッシュ(7桁以上の16進)を1つ取り出す
  #   3) ハッシュが取れたら git show で詳細を表示
  cat > "$PREVIEW_HELPER" <<'EOS'
#!/bin/sh
line="$1"
hash=$(printf '%s' "$line" | sed 's/\x1b\[[0-9;]*m//g' | grep -oE '[0-9a-f]{7,}' | head -1)
if [ -n "$hash" ]; then
  git show --color=always "$hash"
fi
EOS
  chmod +x "$PREVIEW_HELPER"

  # fzf にログを流し込み、コミットを1件選べるようにする。
  #   --ansi             : 色(ANSIエスケープ)をそのまま表示する
  #   --no-sort          : 既にログ順に並んでいるので並べ替えない
  #   --layout=reverse   : 最新コミットを一番上に表示する
  #   --preview          : ヘルパーに選択行 {} を渡して詳細表示
  #   --preview-window   : プレビューを右側60%幅で表示
  #
  # decorate を通してタブ(%x09)をスペースに変換してから fzf に渡す。
  # タブが残ると fzf の {} 受け渡しで行が途中で切れることがあるため。
  # || true: fzf を選択せず終了(Esc)すると終了コード130等を返すが、
  #          set -e で止まらないよう吸収する。
  #
  # --bind: コミット一覧(左側)とプレビュー(右側)の操作を割り当てる。
  #     Ctrl-J / Ctrl-K        : コミット一覧を下/上に移動
  #     Ctrl-F / Ctrl-B        : プレビューを半画面ずつ下/上にスクロール
  #     Ctrl-/                 : プレビューの表示/非表示を切り替え
  run_git_log | decorate | fzf \
    --ansi \
    --no-sort \
    --layout=reverse \
    --preview "sh '$PREVIEW_HELPER' {}" \
    --preview-window=right:60% \
    --bind 'ctrl-j:down,ctrl-k:up' \
    --bind 'ctrl-f:preview-half-page-down,ctrl-b:preview-half-page-up' \
    --bind 'ctrl-/:toggle-preview' || true

  # fzf が終了したのでヘルパーを削除する。
  rm -f "$PREVIEW_HELPER"
else
  # === スクロール表示モード ===
  # -s 指定時、fzf が無いとき、TTY でないとき(パイプ等)はこちら。

  # 整形したログを less に渡す。
  #   -R : 色のエスケープシーケンスを解釈して色付きで表示する
  #   -F : 1画面に収まる短い出力ならページャを使わずそのまま表示する
  #   -X : 終了時に画面をクリアしない(ログが端末に残る)
  # less の中の操作: ↑↓ または j/k で1行、スペースで1画面送り、q で終了。
  #
  # なお less が無い環境でも最低限動くよう、無ければそのまま出力する。
  if command -v less >/dev/null 2>&1; then
    run_git_log | decorate | less -R -F -X
  else
    run_git_log | decorate
  fi
fi
