#!/bin/bash

if ! type tmux >/dev/null 2>&1; then
    echo 'Error: tmux command not found' >&2
    exit 1
fi

# Check for help option early
for arg in "$@"; do
    if [[ "$arg" == "--help" || "$arg" == "-h" ]]; then
        cat <<EOF
Usage: tmuxx [SESSION_NAME] [OPTIONS]

Arguments:
  SESSION_NAME    Name of tmux session (prompted if not provided)

Options:
  --wide          Create 4-pane wide layout (2x2 split)
  --help, -h      Show this help message

Examples:
  tmuxx main
  tmuxx dev --wide
  tmuxx
EOF
        exit 0
    fi
done

if [ -n "$TMUX" ]; then
    echo "Error: tmux session has been already attached" >&2
    exit 1
fi

# Parse arguments
SESSION_NAME=""
LAYOUT_MODE=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --wide)
            LAYOUT_MODE="wide"
            shift
            ;;
        *)
            SESSION_NAME="$1"
            shift
            ;;
    esac
done

# Prompt for session name if not provided
if [ -z "$SESSION_NAME" ]; then
    read -p "Enter tmux session name: " SESSION_NAME
    if [ -z "$SESSION_NAME" ]; then
        echo "Error: session name cannot be empty" >&2
        exit 1
    fi
fi

# Create or attach to session
tmux -CC new -A -s "$SESSION_NAME"

# Apply wide layout if requested (only for new sessions)
if [ "$LAYOUT_MODE" = "wide" ]; then
    tmux split-window -h -t "$SESSION_NAME:1"
    tmux split-window -h -t "$SESSION_NAME:1"
    tmux split-window -v -t "$SESSION_NAME:1.3"
    tmux select-pane -t "$SESSION_NAME:1.1"
fi
